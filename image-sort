#!/usr/bin/env python3
"""image-sort -- friendly launcher for the file-sorting Nextflow pipeline.

Two things to think about: your images on C: (in) and a --dest folder on C: for the
finished videos (out). Everything else is a persistent working store that lives on the
fast local (WSL) disk and is auto-managed -- it accumulates every run's experiments
(data/master_data) and videos (data/videos), and defaults to ~/image-sort-data so you
never set it (override with --out if you must). Experiments finish (move to finished_exp +
stabilized video) automatically when a later run adds no new images to them; you can also
finish specific experiments, or finish everything, on demand.

Modes:
  sort        Sort one run, or several (oldest first), into the store (default). Videos
              appear on their own as experiments go static across runs; runs already
              sorted into the store are skipped.
  finish      Finalize specific experiment number(s) now (move to finished + video).
  finish-all  Finalize everything currently in the store (turn it over).

Imaging geometry comes from the run folder's name: the robot names runs
<timestamp>_<shelves>_<boxes> (e.g. 20260613120000_3_8), so the shelf count and
boxes-per-shelf are both read from it -- you don't enter them. Use --shelves /
--boxes-per-shelf to override for ad-hoc folders.

Transient working files (Nextflow work dir, run staging) live under ~/.cache/image-sort,
never in your output location. Stdlib only -- nothing to pip-install (see README to install).
"""
import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path

PIPELINE = "the-rhizodynamics-robot/file-sorting"
REVISION = "main"
CACHE = Path.home() / ".cache" / "image-sort"


# ---------- path helpers ----------
def win_to_wsl(p: str) -> str:
    """C:\\Users\\x -> /mnt/c/Users/x ; leave POSIX paths alone."""
    p = p.strip().strip('"').strip("'")
    if len(p) >= 2 and p[1] == ":" and p[0].isalpha():
        return f"/mnt/{p[0].lower()}/" + p[2:].replace("\\", "/").lstrip("/")
    return p.replace("\\", "/")


def to_path(raw: str, what: str) -> Path:
    """Convert a pasted Windows/WSL path to a Path, rejecting UNC paths clearly."""
    s = raw.strip().strip('"').strip("'")
    if s.startswith("\\\\") or s.startswith("//"):
        sys.exit(
            f"{what}: network/UNC paths (\\\\server\\share) aren't supported here.\n"
            "Copy the data onto a local drive (e.g. C:\\...) or into WSL first."
        )
    return Path(win_to_wsl(s))


def win_display(p: Path):
    """/mnt/c/Users/x -> C:\\Users\\x for display; None if not a Windows mount."""
    s = str(p)
    if s.startswith("/mnt/") and len(s) > 6 and s[6] == "/":
        return s[5].upper() + ":" + s[6:].replace("/", "\\")
    return None


def wsl_unc(p: Path) -> str:
    distro = os.environ.get("WSL_DISTRO_NAME", "Ubuntu")
    return "\\\\wsl.localhost\\" + distro + str(p).replace("/", "\\")


def on_wsl() -> bool:
    """True only on WSL (so we don't print Windows-isms on a native Linux box)."""
    if os.environ.get("WSL_DISTRO_NAME") or os.environ.get("WSL_INTEROP"):
        return True
    if shutil.which("wslpath") or Path("/run/WSL").is_dir():
        return True
    try:
        return "microsoft" in Path("/proc/sys/kernel/osrelease").read_text().lower()
    except OSError:
        return False


# ---------- prompts ----------
def ask(msg, default=None, cast=str, ok=lambda v: True):
    while True:
        raw = input(f"{msg}{f' [{default}]' if default is not None else ''}: ").strip()
        if not raw:
            if default is not None:
                return default
            print("  (required)")
            continue
        try:
            val = cast(raw)
        except ValueError:
            print(f"  not a valid {cast.__name__}")
            continue
        if not ok(val):
            print("  invalid value")
            continue
        return val


def ask_yes(msg, default=True):
    raw = input(f"{msg} [{'Y/n' if default else 'y/N'}]: ").strip().lower()
    return default if not raw else raw.startswith("y")


# ---------- environment ----------
def preflight():
    """Fail early, with a clear message, if the environment isn't ready."""
    missing = []
    if not shutil.which("nextflow"):
        missing.append("nextflow  (https://www.nextflow.io/ -- needs Java 11+)")
    if not shutil.which("java"):
        missing.append("java 11+  (e.g. sudo apt install default-jre)")
    if not shutil.which("docker"):
        missing.append("docker    (the Docker engine)")
    if missing:
        sys.exit("Missing required tools:\n  - " + "\n  - ".join(missing))

    r = subprocess.run(["docker", "info"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.PIPE, text=True)
    if r.returncode != 0:
        if "permission denied" in (r.stderr or "").lower():
            sys.exit(
                "Docker is installed but you don't have permission to use it.\n"
                "Add yourself to the docker group, then restart WSL:\n"
                "  sudo usermod -aG docker $USER\n"
                "  (then run `wsl --shutdown` from Windows and reopen Ubuntu)"
            )
        sys.exit(
            "Docker is installed but the daemon isn't reachable.\n"
            "Start it (Docker Desktop, or `sudo service docker start`) and try again."
        )


def run_step(cmd, cwd, fatal=True):
    """Run one pipeline step. Exits on failure, or returns False if fatal=False."""
    if subprocess.run(cmd, env=dict(os.environ), cwd=str(cwd)).returncode != 0:
        if fatal:
            sys.exit("\nA pipeline step failed -- see the Nextflow output above.")
        return False
    return True


# ---------- cache / store helpers ----------
# The output location (--out) holds ONLY data/. All transient bits -- the Nextflow work
# dir, the run-staging symlink, the finish placeholder, and the small per-location memory
# (boxes-per-shelf / stabilize / last-used) -- live under ~/.cache/image-sort instead.
def cache_subdir(*parts):
    d = CACHE.joinpath(*parts)
    d.mkdir(parents=True, exist_ok=True)
    return d


def work_dir_for(store):
    """Nextflow work dir for a location, kept OUT of it (transient, resumable)."""
    tag = hashlib.sha1(str(store).encode()).hexdigest()[:12]
    return cache_subdir("work", tag)


def _read_all_meta():
    f = CACHE / "stores.json"
    if f.is_file():
        try:
            return json.loads(f.read_text())
        except Exception:
            return {}
    return {}


def _write_all_meta(data):
    try:
        CACHE.mkdir(parents=True, exist_ok=True)
        (CACHE / "stores.json").write_text(json.dumps(data, indent=2))
    except OSError:
        pass


def load_meta(store):
    return _read_all_meta().get("stores", {}).get(str(store), {})


def save_meta(store, meta):
    data = _read_all_meta()
    data.setdefault("stores", {})[str(store)] = meta
    data["last"] = str(store)
    _write_all_meta(data)


def last_store():
    return _read_all_meta().get("last")


DEFAULT_STORE = Path.home() / "image-sort-data"


def resolve_store(a, interactive):
    """The persistent working store (== --sort_path). It lives on the fast local (WSL) disk
    and is auto-managed -- you normally never touch it; finished videos come out on C: via
    --dest. Resolution order: explicit --out  >  last-used (remembered)  >  ~/image-sort-data.
    """
    raw = a.out or last_store() or str(DEFAULT_STORE)
    store = to_path(raw, "Output location").resolve()
    data = _read_all_meta()
    data["last"] = str(store)
    _write_all_meta(data)
    return store


def stabilized_videos(sort_path):
    """{(name, mtime)} for every finished video. Only ever used as a before/after set
    difference. mtime is part of the key because experiment labels come from the QR codes
    and can repeat (recycled labels while testing): on names alone, re-rendering an
    existing number looks like nothing happened, so it is neither copied nor reported."""
    d = sort_path / "data" / "videos" / "stabilized"
    return {(p.name, p.stat().st_mtime) for p in d.glob("*.mp4")} if d.is_dir() else set()


def derive_geometry(folder_name):
    """(shelves, boxes) from a run-folder name '<timestamp>_<shelves>_<boxes>'.

    The robot encodes both: number after the final underscore is boxes-per-shelf, the one
    before it is the shelf count. Returns ints, or (None, None) if the name doesn't carry
    both (older '<timestamp>_<shelves>' folders, or ad-hoc names -- use --shelves /
    --boxes-per-shelf then).
    """
    parts = folder_name.rsplit("_", 2)
    if len(parts) == 3 and parts[1].isdigit() and parts[2].isdigit():
        return int(parts[1]), int(parts[2])
    return None, None


IMAGE_EXTENSIONS = {".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff"}  # as the sorter ingests
RUN_TIMESTAMP = re.compile(r"^(\d{14})_")   # robot run folders start <YYYYMMDDHHMMSS>_


def has_images(folder):
    try:
        return any(p.is_file() and p.suffix.lower() in IMAGE_EXTENSIONS
                   for p in folder.iterdir())
    except OSError:
        return False


def collect_runs(raw_paths):
    """Run folders to sort, oldest first, plus (name, why) for folders skipped as empty.

    Each path is either a run folder (it holds images) or a parent of run folders. Several
    runs are ordered by the timestamp the robot puts at the start of each folder name; the
    sorter appends each run's frames to the experiment of the same QR label, so order is
    the experiment's timeline and is never guessed.
    """
    runs, empty = [], []
    for raw in raw_paths:
        p = to_path(raw, "Images folder")
        if not p.is_dir():
            hint = ("\n(if this is on a network or external drive, it may not be mounted in WSL)"
                    if str(p).startswith("/mnt/") else "")
            sys.exit(f"Images folder not found: {p}{hint}")
        if has_images(p):
            runs.append(p)
            continue
        found = False
        for sub in sorted(q for q in p.iterdir() if q.is_dir()):
            if has_images(sub):
                runs.append(sub)
                found = True
            elif RUN_TIMESTAMP.match(sub.name):
                empty.append((sub.name, "no images (archived or empty)"))
        if not found:
            sys.exit(f"No images in {win_display(p) or p}, and no run folders with images "
                     "inside it.")
    runs = list({r.resolve(): r for r in runs}.values())   # same folder given twice
    if len(runs) > 1:
        undated = [r.name for r in runs if not RUN_TIMESTAMP.match(r.name)]
        if undated:
            sys.exit("Can't order these runs: their names don't start with the robot's "
                     "<YYYYMMDDHHMMSS>_ timestamp:\n  " + "\n  ".join(undated) +
                     "\nRename them, or sort them one at a time, oldest first.")
        runs.sort(key=lambda r: RUN_TIMESTAMP.match(r.name).group(1))
    return runs, empty


# ---------- sorted-runs ledger ----------
# Sorting a run twice appends its frames to the experiments twice, so the store records
# every run it has sorted. It lives inside the store (data/), so it travels with the data
# and survives clearing ~/.cache.
def ledger_file(store):
    return store / "data" / "sorted_runs.json"


def load_ledger(store):
    try:
        return json.loads(ledger_file(store).read_text())
    except (OSError, ValueError):
        return {}


def record_sorted(store, name, source, how="sorted"):
    ledger = load_ledger(store)
    ledger[name] = {how: datetime.now().isoformat(timespec="seconds"), "source": source}
    ledger_file(store).parent.mkdir(parents=True, exist_ok=True)
    ledger_file(store).write_text(json.dumps(ledger, indent=2))


def already_sorted(store, ledger, names):
    """How a run was recorded as sorted, or None. Runs sorted with --archive before the
    ledger existed are recognised by their archived copy."""
    for n in names:
        if n in ledger:
            e = ledger[n]
            return f"{'marked sorted' if 'marked' in e else 'sorted'} {e.get('sorted') or e.get('marked')}"
        if (store / "data" / "unsorted_unlabeled_processed" / n).is_dir():
            return "archived in the store"
    return None


def exp_dirs(store, sub):
    d = store / "data" / "master_data" / sub
    return {p.name for p in d.iterdir() if p.is_dir() and not p.name.startswith(".")} \
        if d.is_dir() else set()


def finish_collisions(store):
    """Labels in both current_exp/ and finished_exp/. When such an experiment finishes, the
    pipeline's move into finished_exp/ fails -- crashing the run, or rendering the old
    folder's video -- so these must be cleared before sorting on."""
    return sorted(exp_dirs(store, "current_exp") & exp_dirs(store, "finished_exp"))


def collision_message(store, labels):
    fin = store / "data" / "master_data" / "finished_exp"
    return ("These experiments are in BOTH current_exp/ and finished_exp/: "
            f"{', '.join(labels)}\n"
            "Finishing them would collide with the old finished folder (crash, or a video of the\n"
            "old data). Usually the old one is from a recycled QR label. Rename or move the old\n"
            f"folder(s) out of:\n  {win_display(fin) or fin}\n"
            "then run the same command again (runs already sorted are skipped).")


def nf_base(sort_path, work_dir, revision, archive=False):
    return ["nextflow", "run", PIPELINE, "-r", revision, "-latest", "-profile", "local",
            "-work-dir", str(work_dir),
            "--sort_path", str(sort_path),
            "--unzip", "false", "--archive", "true" if archive else "false"]


def default_dest(wsl):
    """Default drop-off for finished videos: <Desktop>/final_imaging_data.

    On WSL that's the *Windows* user's Desktop (so videos land on C: and show up
    in Explorer). The WSL username can differ from the Windows one, so we ask
    Windows for %USERPROFILE% via cmd.exe rather than guessing from $HOME.
    Running from /mnt/c keeps cmd.exe from printing its UNC-path warning.
    On native Linux (or if that probe fails) fall back to ~/Desktop, else ~."""
    if wsl:
        try:
            r = subprocess.run(["cmd.exe", "/c", "echo %USERPROFILE%"],
                               capture_output=True, text=True, cwd="/mnt/c")
            prof = r.stdout.strip()
            if len(prof) >= 2 and prof[1] == ":" and prof[0].isalpha():
                return Path(win_to_wsl(prof)) / "Desktop" / "final_imaging_data"
        except Exception:
            pass
    home = Path.home()
    base = home / "Desktop" if (home / "Desktop").is_dir() else home
    return base / "final_imaging_data"


def resolve_dest(a, wsl, interactive):
    """Where finished videos are placed for the user -- the one path they care about. The
    store keeps its own copy regardless; this is the convenient (e.g. C:\\) drop-off.
    Defaults to <Desktop>/final_imaging_data when nothing is supplied."""
    default = default_dest(wsl)
    if a.dest is not None:
        raw = a.dest
    elif interactive:
        q = "Folder on C: for the finished videos" if wsl else "Folder for the finished videos"
        shown = win_display(default) or str(default)
        raw = input(f"{q} [{shown}]: ").strip()
        if not raw:
            return default
    else:
        return default
    return to_path(raw, "Destination").resolve() if raw else default


def junk_review_items(sort_path):
    """Experiment folders parked in junk_review/ awaiting a human (excludes the re_merge
    subfolder and hidden files). Non-empty => the sorter couldn't read a QR for them, so the
    pipeline skipped finalizing them and printed a notice into its (captured) container log."""
    d = sort_path / "data" / "master_data" / "junk_review"
    if not d.is_dir():
        return []
    return sorted(p.name for p in d.iterdir()
                  if p.name != "re_merge" and not p.name.startswith("."))


def finish_report(sort_path, before, dest, wsl):
    """Copy newly-rendered stabilized videos to dest (if any) and print where things landed."""
    new = sorted(name for name, _ in stabilized_videos(sort_path) - before)
    stab = sort_path / "data" / "videos" / "stabilized"
    copied = []
    if dest and new:
        print(f"-> Copying {len(new)} new video(s) to {win_display(dest) or dest} ...")
        try:
            dest.mkdir(parents=True, exist_ok=True)
            for v in new:
                shutil.copy2(stab / v, dest / v)
                copied.append(v)
        except (PermissionError, OSError) as e:
            print(f"  WARNING: could not copy videos to {dest}: {e}")

    print("\nDone.")
    print(f"  Store (all experiments + videos): {win_display(sort_path) or sort_path}")
    print(f"  Intermediate work files (safe to delete): {work_dir_for(sort_path)}")
    if new:
        print(f"  Finished this run: {', '.join(v[:-4] for v in new)}")
        print(f"  Videos:  {stab}")
    else:
        print("  No experiments finished this run.")
    if wsl:
        print(f"  Open store in Explorer: {wsl_unc(sort_path)}")
    if copied:  # only when files actually landed there -- this used to print on any --dest
        print(f"  Copied {len(copied)} video(s) to: {win_display(dest) or dest}")
    elif dest and new:
        print(f"  NOT copied to {win_display(dest) or dest} -- see the warning above.")

    pending = junk_review_items(sort_path)
    if pending:
        jr = sort_path / "data" / "master_data" / "junk_review"
        print(f"\n  WARNING -- junk review: {len(pending)} experiment folder(s) need attention.")
        print("     The sorter couldn't read a QR for these, so they were NOT finalized.")
        print("     Open the folder below, move any you want to keep into its 're_merge'")
        print("     subfolder (renamed with the correct experiment number), then re-run:")
        print(f"       {win_display(jr) or jr}")
        if wsl:
            print(f"       Explorer: {wsl_unc(jr)}")


# ---------- modes ----------
def run_geometry(a, folder, meta):
    """(shelves, boxes, staged_name) for one run; exits with a clear message if unreadable."""
    source_name = folder.name
    name_shelves, name_boxes = derive_geometry(source_name)
    shelves = a.shelves if a.shelves else name_shelves
    if shelves is None:
        sys.exit(f"Couldn't read the shelf count from folder name '{source_name}'.\n"
                 "The robot names runs <timestamp>_<shelves>_<boxes> (e.g. 20260613120000_3_8).\n"
                 "Pass --shelves N (and --boxes-per-shelf N), or rename the folder.")
    shelves = int(shelves)
    if not (1 <= shelves <= 99):
        sys.exit(f"Implausible shelf count ({shelves}) read from '{source_name}'.\n"
                 "If the folder name's trailing _<shelves>_<boxes> is wrong, pass --shelves N.")
    boxes = a.boxes_per_shelf or name_boxes or meta.get("boxes_per_shelf")
    if not boxes:
        boxes = ask(f"Boxes per shelf for {source_name}", default=2, cast=int, ok=lambda v: v > 0)
    boxes = int(boxes)
    # The pipeline reads geometry from the staged folder name, so it must end in
    # '_<shelves>_<boxes>'. Robot folders already do; otherwise append it (needed for
    # --shelves/--boxes-per-shelf overrides / non-conventional names).
    geo_suffix = f"_{shelves}_{boxes}"
    staged_name = source_name if source_name.endswith(geo_suffix) else source_name + geo_suffix
    return shelves, boxes, staged_name


def sort_one(a, store, work_dir, folder, shelves, boxes, staged_name, stabilize):
    """Run the pipeline on one run folder. Returns True on success."""
    # Staging lives in the cache -- NOT the location -- so the location only ever holds data/.
    staged = cache_subdir("staging") / staged_name
    if staged.is_symlink() or staged.exists():
        staged.unlink()
    staged.symlink_to(folder, target_is_directory=True)

    # Defensive: clear transient ingest residue left by an interrupted prior run with this name
    # (the pipeline's copytree into unsorted_unlabeled/<name> errors if it already exists).
    for sub in ("unsorted_unlabeled", "sorted_unlabeled"):
        leftover = store / "data" / "master_data" / sub / staged_name
        if leftover.exists():
            shutil.rmtree(leftover, ignore_errors=True)

    cmd = nf_base(store, work_dir, a.revision, archive=a.archive) + [
        "--images_path", str(staged),
        "--boxes_per_shelf", str(boxes),
        "--stabilize", "true" if stabilize else "false",
    ]
    print(f"\n-> Sorting {folder.name} into {win_display(store) or store}  "
          f"({boxes} boxes x {shelves} shelves"
          f"{'; archiving source after' if a.archive else ''})...")
    return run_step(cmd, cache_subdir("run"), fatal=False)


def do_sort(a, wsl, interactive):
    """Sort one or more runs into the store, oldest first.

    Each sort finishes (moves to finished_exp + renders) every experiment that run added
    nothing to -- the robot stopped imaging it -- so sorting runs in time order gives each
    experiment that ended along the way its video. Experiments still being imaged in the
    newest run stay in current_exp/ unless --finish-remaining.
    """
    img_prompt = ("Images folder -- one run, or a folder of runs" +
                  (" (paste the Windows C:\\ path)" if wsl else ""))
    runs, empty = collect_runs(a.images if a.images else [ask(img_prompt)])

    store = resolve_store(a, interactive)
    work_dir = work_dir_for(store)
    where = win_display(store) or store

    if a.overwrite and store.exists():
        if not interactive or ask_yes(
                f"Delete and recreate the ENTIRE location at {where} "
                "(wipes all experiments)?", default=False):
            shutil.rmtree(store)
    store.mkdir(parents=True, exist_ok=True)

    meta = load_meta(store)
    ledger = load_ledger(store)
    plan, skipped = [], list(empty)
    for folder in runs:
        shelves, boxes, staged_name = run_geometry(a, folder, meta)
        done = already_sorted(store, ledger, {folder.name, staged_name})
        if done and not a.resort:
            skipped.append((folder.name, f"already sorted ({done})"))
        else:
            plan.append((folder, shelves, boxes, staged_name))

    if a.mark_sorted:   # record runs sorted before the ledger existed; sort nothing
        for folder, _, _, staged_name in plan:
            record_sorted(store, staged_name, str(win_display(folder) or folder), how="marked")
            print(f"  marked as sorted: {folder.name}")
        for name, why in skipped:
            print(f"  skipped: {name} -- {why}")
        return

    print(f"\nRuns to sort into {where}, oldest first:")
    for i, (folder, shelves, boxes, _) in enumerate(plan, 1):
        print(f"  {i}. {folder.name}  ({shelves} shelf(s) x {boxes} box(es))")
    for name, why in skipped:
        print(f"  -  {name}: skipped, {why}")
    if not plan:
        print("Nothing to sort." + ("  (Use --resort to sort a run again.)" if skipped else ""))
        return
    if a.resort and any(already_sorted(store, ledger, {f.name, s}) for f, _, _, s in plan):
        print("NOTE: --resort -- a run sorted again appends its frames to its experiments again.")

    finish_remaining = a.finish_remaining
    if finish_remaining is None:
        finish_remaining = interactive and ask_yes(
            "After the last run, also make videos for experiments still being imaged in it?",
            default=False)
    if interactive and (len(plan) > 1 or skipped) and not ask_yes(
            f"Sort {'these ' + str(len(plan)) + ' runs in this order' if len(plan) > 1 else 'this run'}?",
            default=True):
        sys.exit("Cancelled.")

    if a.archive:
        # Archiving moves each raw run out of its source folder into the location's
        # data/unsorted_unlabeled_processed/ AFTER images are copied in for sorting. The
        # source folders end up empty -- safe (the images live in the location now), but the
        # original locations are consumed. Confirm interactively since it's not reversible there.
        print("NOTE: --archive will MOVE (empty) each source folder after it is sorted.")
        if interactive and not ask_yes("Proceed and archive (empty) the source folders?", default=True):
            sys.exit("Cancelled.")

    clash = finish_collisions(store)
    if clash:
        sys.exit(collision_message(store, clash))

    stabilize = a.stabilize if a.stabilize is not None else meta.get("stabilize", True)
    dest = resolve_dest(a, wsl, interactive)   # asked up front, not after hours of sorting
    before = stabilized_videos(store)
    sorted_ok, stop = [], None
    for i, (folder, shelves, boxes, staged_name) in enumerate(plan):
        save_meta(store, {"boxes_per_shelf": boxes, "stabilize": stabilize})
        if not sort_one(a, store, work_dir, folder, shelves, boxes, staged_name, stabilize):
            stop = f"Sorting {folder.name} failed -- see the Nextflow output above."
            break
        record_sorted(store, staged_name, str(win_display(folder) or folder))
        sorted_ok.append(folder.name)
        last = i == len(plan) - 1
        # The next sort starts by deleting junk_review/ (clear_junk), and this one skipped
        # finishing because of it -- so stop here rather than lose those folders.
        if junk_review_items(store) and (not last or finish_remaining):
            stop = (f"{folder.name} parked folders in junk review (see below). The next sort "
                    "would delete them, so stopping here.")
            break
        clash = finish_collisions(store)
        if clash and (not last or finish_remaining):
            stop = collision_message(store, clash)
            break

    if not stop and finish_remaining:
        remaining = sorted(exp_dirs(store, "current_exp"))
        if remaining:
            exps = ",".join(remaining)
            print(f"\n-> Finishing experiments still being imaged in the newest run: {exps}")
            cmd = nf_base(store, work_dir, a.revision) + [
                "--images_path", str(cache_subdir("staging", "_finish_placeholder")),
                "--boxes_per_shelf", str(plan[-1][2]),
                "--stabilize", "true" if stabilize else "false",
                "--finish_experiments", exps,
            ]
            if not run_step(cmd, cache_subdir("run"), fatal=False):
                stop = "Finishing the remaining experiments failed -- see the Nextflow output above."

    finish_report(store, before, dest, wsl)
    if len(plan) > 1 or stop:
        print(f"\n  Sorted {len(sorted_ok)} of {len(plan)} run(s): {', '.join(sorted_ok) or 'none'}")
    if stop:
        print(f"\nSTOPPED: {stop}")
        print("Fix that, then run the same command again: runs already sorted are skipped.")
        sys.exit(1)
    if not finish_remaining and exp_dirs(store, "current_exp"):
        print("  Experiments still being imaged stay in current_exp/ until a later run adds "
              "nothing to them (or use --mode finish / --finish-remaining).")


def do_finish(a, wsl, interactive, mode):
    store = resolve_store(a, interactive)
    work_dir = work_dir_for(store)
    if not (store / "data" / "master_data").is_dir():
        sys.exit(f"No store found at {win_display(store) or store}. Sort a run into it first.")

    meta = load_meta(store)
    boxes = a.boxes_per_shelf or meta.get("boxes_per_shelf") or 1  # placeholder; not used to sort
    stabilize = a.stabilize if a.stabilize is not None else meta.get("stabilize", True)

    # The finish branch ignores images, but the pipeline still stages an images path -> give it
    # a harmless empty placeholder (in the cache, not the location).
    placeholder = cache_subdir("staging", "_finish_placeholder")

    cmd = nf_base(store, work_dir, a.revision) + [
        "--images_path", str(placeholder),
        "--boxes_per_shelf", str(boxes),
        "--stabilize", "true" if stabilize else "false",
    ]

    where = win_display(store) or store
    if mode == "finish":
        raw = a.exp or ask("Experiment number(s) to finish (comma-separated)")
        exps = ",".join(e.strip() for e in raw.split(",") if e.strip())
        if not exps:
            sys.exit("No experiment numbers given.")
        cmd += ["--finish_experiments", exps]
        print(f"\n-> Finishing experiment(s) {exps} in {where}...")
    else:  # finish-all
        if interactive and not ask_yes(
                f"Finish ALL experiments in {where} and turn it over?", default=False):
            sys.exit("Cancelled.")
        cmd += ["--finish_only", "true"]
        print(f"\n-> Finishing ALL experiments in {where} (turning it over)...")

    before = stabilized_videos(store)
    run_step(cmd, cache_subdir("run"))
    dest = resolve_dest(a, wsl, interactive)
    finish_report(store, before, dest, wsl)


def main():
    ap = argparse.ArgumentParser(description="Sort robot images and build root-growth videos.")
    ap.add_argument("--mode", choices=["sort", "finish", "finish-all"],
                    help="What to do (default: inferred -- sort if --images, finish if --exp).")
    ap.add_argument("--out", help="(advanced) Working store dir on the fast local disk, "
                                  "auto-managed; defaults to ~/image-sort-data. You normally "
                                  "don't set this -- finished videos come out via --dest.")
    ap.add_argument("--images", nargs="+",
                    help="[sort] Run folder(s), or a folder containing run folders (Windows or "
                         "WSL paths). Several runs are sorted oldest first, by the timestamp at "
                         "the start of each folder name; runs already sorted are skipped.")
    ap.add_argument("--exp", help="[finish] Experiment number(s) to finalize, comma-separated.")
    ap.add_argument("--boxes-per-shelf", type=int,
                    help="[sort] Override boxes per shelf (normally read from the folder name; "
                         "remembered per location as a fallback).")
    ap.add_argument("--shelves", type=int,
                    help="[sort] Override shelf count (normally read from the folder name).")
    ap.add_argument("--dest", help="Folder on C: where finished videos are placed (what you "
                                   "open). Optional; if omitted they stay in the store.")
    ap.add_argument("--stabilize", dest="stabilize", action="store_true", default=None,
                    help="Stabilize videos (default).")
    ap.add_argument("--no-stabilize", dest="stabilize", action="store_false",
                    help="Skip stabilization.")
    ap.add_argument("--archive", action="store_true",
                    help="[sort] After sorting, MOVE the raw run out of the source folder into "
                         "the location's data/unsorted_unlabeled_processed/ (empties the source).")
    ap.add_argument("--overwrite", action="store_true",
                    help="[sort] Delete and recreate the ENTIRE output location before sorting.")
    ap.add_argument("--finish-remaining", dest="finish_remaining", action="store_true",
                    default=None,
                    help="[sort] After the last run, also make videos for the experiments still "
                         "being imaged in it (default: leave them for a later run).")
    ap.add_argument("--no-finish-remaining", dest="finish_remaining", action="store_false",
                    help="[sort] Don't ask; leave experiments still being imaged in current_exp/.")
    ap.add_argument("--resort", action="store_true",
                    help="[sort] Sort runs even if already sorted into this store (appends their "
                         "frames again).")
    ap.add_argument("--mark-sorted", action="store_true",
                    help="[sort] Record the given runs as already sorted, without sorting -- for "
                         "runs sorted before this store kept a record.")
    ap.add_argument("--revision", default=REVISION, help="Pipeline git revision to run (advanced).")
    a = ap.parse_args()

    preflight()
    wsl = on_wsl()
    interactive = sys.stdin.isatty()

    mode = a.mode
    if mode is None:
        if a.exp is not None:
            mode = "finish"
        elif a.images is not None:
            mode = "sort"
        elif interactive:
            print("What would you like to do?")
            print("  1) Sort run(s) into your output location")
            print("  2) Finish specific experiments (make videos)")
            print("  3) Finish all experiments (turn over the location)")
            mode = {"1": "sort", "2": "finish", "3": "finish-all"}[
                ask("Choose", default="1", ok=lambda v: v in ("1", "2", "3"))]
        else:
            sys.exit("Nothing to do. Pass --mode sort|finish|finish-all (or --images / --exp).")

    if mode == "sort":
        do_sort(a, wsl, interactive)
    else:
        do_finish(a, wsl, interactive, mode)


if __name__ == "__main__":
    main()
