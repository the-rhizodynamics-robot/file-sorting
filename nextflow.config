// Memory ceiling for the pipeline's container. If the pipeline ever needs more, Docker stops
// THIS container with an out-of-memory error instead of the whole machine (or the WSL VM, and
// everything running in it) running out. Measured 2026-10-16: sorting + QR check + labelling
// peak ~2.1 GB; a 319-frame 3000x3000 box's videos ~3.5 GB with ffmpeg limited to 4 threads.
// Override per run with --docker_memory (e.g. 8g on a machine with RAM to spare).
params.docker_memory = '4g'

profiles {
    local {
        process {
            executor = 'local'
            container = 'ghcr.io/the-rhizodynamics-robot/file-sorting-env:latest'
        }
         docker {
            enabled = true
            runOptions = '-u $(id -u):$(id -g) --memory=' + params.docker_memory + ' --memory-swap=' + params.docker_memory
        }
    }
}
